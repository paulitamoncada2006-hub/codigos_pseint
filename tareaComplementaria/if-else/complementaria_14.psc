Algoritmo complementaria_14
	//Verificación de ahorro: Como ahorrador, quiero ingresar mi dinero ahorrado para determinar si he alcanzado una meta de $500.000.
	Definir ahorro Como Real;
	Escribir "Ingrese su dinero ahorrado: "
	Leer ahorro;
	
	Si ahorro >= 500000 Entonces
		Escribir "¡Haz alcanzado tu meta!";
	SiNo
		Escribir "	TE FALTA AHORRAR UN POCO MÁS "
	FinSi
	
FinAlgoritmo
