Algoritmo complementaria_8
	//Verificación de número: Como usuario, quiero ingresar dos números para determinar cuál de los dos es mayor 
	//o si el primero no es mayor que el segundo.
	Definir num1, num2 Como Entero;
	Escribir "Ingrese el número 1: ";
	Leer num1;
	Escribir "Ingrese el número 2: ";
	Leer num2;
	
	Si num1 < num2 Entonces
		Escribir "El segundo número es mayor"
	SiNo
		Escribir "El primer número es mayor que el segundo número"
	FinSi
	
	
FinAlgoritmo
