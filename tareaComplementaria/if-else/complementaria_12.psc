Algoritmo complementaria_12
	//Control de calidad de productos: Como trabajador de una fábrica, quiero ingresar el peso de un producto
	//para determinar si cumple con el peso requerido de 500 gramos.
	Definir pesoP Como Entero;
	Escribir "Ingrese el peso del producto en gramos"
	Leer pesoP
	Si pesoP <= 500 Entonces
		Escribir "Cumple con el peso"
	SiNo
		Escribir "No cumple con el peso requerido"
	FinSi
	
FinAlgoritmo
