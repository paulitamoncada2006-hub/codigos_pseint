Algoritmo complementaria_6
	//Verificación de temperatura de un refrigerador: Como encargado de una tienda, quiero ingresar la temperatura del refrigerador
	//para comprobar si se encuentra dentro del límite de 5 °C.
	Definir temp Como Entero;
	Escribir "Ingrese la temperatura del refrigerador: "
	Leer temp;
	
	Si temp < 5 Entonces
		Escribir "Está dentro del limite"
	SiNo
		Escribir "Fuera del limite"
	FinSi
FinAlgoritmo
