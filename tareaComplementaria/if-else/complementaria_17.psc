Algoritmo complementaria_17
	//Evaluación de rendimiento: Como profesor, quiero ingresar la calificación de un estudiante para determinar si obtuvo un 
	//rendimiento satisfactorio con una nota igual o superior a 4.0.
	Definir calificación Como Real
	Escribir "Ingrese calificación del estudiante"
	Leer calificación;
	
	Si calificación >= 4.0 Entonces
		Escribir "Rendimiento satisfactorio"
	SiNo
		Escribir "Debes mejorar tu rendimiento"
	FinSi
	
FinAlgoritmo
