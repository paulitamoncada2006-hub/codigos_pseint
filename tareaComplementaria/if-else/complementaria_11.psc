Algoritmo complementaria_11
	//Verificación de vacaciones: Como empleado, quiero ingresar los años que llevo trabajando en una empresa para determinar 
	//si cumplo con el requisito de un año de antigüedad para solicitar vacaciones.
	Definir añosT Como Entero;
	Escribir "¿Cuántos años llevas trabajando en la empresa?"
	Leer añosT;
	
	Si añosT >= 1 Entonces
		Escribir" ¡Cumple con el requisito!, puede solicitar vacaciones "
	SiNo
		Escribir "No cumple con el requisito"
	FinSi
	
FinAlgoritmo
