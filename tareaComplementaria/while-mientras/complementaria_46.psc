Algoritmo complementaria_46
	//quiero ingresar una contraseña hasta que escriba 
	//la correcta para permitir el acceso al sistema.
	Definir contraseña Como Entero
	contraseña<-123
	Escribir "Ingrese un número de tres digitos para saber si es correcta"
	Leer contraseña
	Mientras contraseña <> 123 Hacer
		Escribir "Digite contraseña nuevamente"
		Leer contraseña
	FinMientras
	Escribir "Permitir Acceso al Sistema"
FinAlgoritmo
